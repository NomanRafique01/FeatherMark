{
  "name": "feathermark",
  "productName": "FeatherMark",
  "version": "2.0.0",
  "description": "FeatherMark",
  "main": "main.js",
  "author": "FeatherMark",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "esbuild ./renderer/app.jsx --bundle --jsx=automatic --jsx-import-source=preact --loader:.jsx=jsx --loader:.woff2=file --loader:.woff=file --format=iife --outfile=./renderer/dist/app.js",
    "watch:renderer": "npm run build:renderer -- --watch",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "codemirror": "^6.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "preact": "^10.25.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  }
}
